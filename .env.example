# WARNING: This file contains hardcoded credentials for training purposes
# In a real application, NEVER commit .env files to Git!

DB_HOST=localhost
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# VULNERABILITY: Hardcoded JWT secret (should be random and secure)
# run `openssl rand -base64 32` to generate JWT_SECRET
JWT_SECRET=

# VULNERABILITY: Hardcoded API key
# run `openssl rand -base64 32` to generate ADMIN_API_KEY
ADMIN_API_KEY=

SERVER_PORT=
